pragma solidity 0.8.30;

import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts-upgradeable/utils/ContextUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/access/manager/AccessManagedUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/ReentrancyGuardUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";

interface IStrategy {
    function invest(uint256 amount) external returns (bool);
    function divest(uint256 amount) external returns (uint256);
    function harvest() external;
    function totalAssets() external view returns (uint256);
}

abstract contract BaseStrategy is Initializable, IStrategy, ContextUpgradeable, AccessManagedUpgradeable, ReentrancyGuardUpgradeable, UUPSUpgradeable {
    using SafeERC20 for IERC20;

    /* ---------- state ----------*/
    address public reservoir;
    IERC20  public usdc;

    /* ---------- modifiers ----------*/
    modifier onlyReservoir() {
        require(_msgSender() == reservoir, "Not reservoir");
        _;
    }

    /* ---------- init ----------*/
    function __BaseStrategy_init(address _usdc, address _reservoir, address _accessManager) internal onlyInitializing {
        __Context_init();
        __AccessManaged_init(_accessManager);
        __ReentrancyGuard_init();

        usdc = IERC20(_usdc);
        reservoir = _reservoir;
    }

    /* ---------- IStrategy wrappers ----------*/
    function invest(uint256 amount) external virtual override onlyReservoir nonReentrant returns (bool) {
        _invest(amount);
        return true;
    }

    function divest(uint256 amount) external virtual override onlyReservoir nonReentrant returns (uint256) {
        return _divest(amount);
    }

    function harvest() external virtual override restricted nonReentrant {
        _harvest();
    }

    /* ---------- internal to override ----------*/
    function _invest(uint256 amount) internal virtual;
    function _divest(uint256 amount) internal virtual returns (uint256);
    function _harvest() internal virtual;

    /* ---------- UUPS ----------*/
    /// @notice While restricted is applied to the internal _authorizeUpgrade function, AccessManager should be configured to restrict call to upgradeToAndCall function, as it's the public entry point.
    function _authorizeUpgrade(address newImplementation) internal override restricted {}

    uint256[50] private __gap;
}

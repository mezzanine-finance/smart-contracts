// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

/**
 * SwapperToUSDC (Uniswap v3, single-hop only, UUPS upgradeable)
 *
 * Use cases:
 * 1) Swap a supported stable -> USDC and send USDC to the caller.
 * 2) Swap a supported stable -> USDC -> call MZUSD.deposit() and send MZUSD to a recipient.
 *
 * Notes:
 * - Only single-hop via Uniswap v3 exactInputSingle. Each supported stable has a fixed pool fee.
 * - If tokenIn == USDC in the (2) flow, swap is skipped and deposit() is called directly.
 * - Caller must approve this contract to spend tokenIn (or USDC in the direct-deposit branch).
 */

import "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/PausableUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/ReentrancyGuardUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

interface IMZUSD is IERC20 {
    /// @notice Mints 1:1 MZUSD to msg.sender by transferring USDC from msg.sender to the Vault.
    function deposit(uint256 amount) external;
}

interface ISwapRouterV3 {
    struct ExactInputSingleParams {
        address tokenIn;
        address tokenOut;
        uint24  fee;               // 100=0.01%, 500=0.05%, 3000=0.3%, 10000=1%
        address recipient;
        uint256 deadline;
        uint256 amountIn;
        uint256 amountOutMinimum;
        uint160 sqrtPriceLimitX96; // 0 = no price limit
    }
    function exactInputSingle(ExactInputSingleParams calldata params) external payable returns (uint256 amountOut);
}

contract SwapperToUSDC is
    Initializable,
    AccessControlUpgradeable,
    PausableUpgradeable,
    ReentrancyGuardUpgradeable,
    UUPSUpgradeable
{
    using SafeERC20 for IERC20;

    // --- roles ---
    bytes32 public constant ADMIN_ROLE  = keccak256("ADMIN_ROLE");
    bytes32 public constant PAUSER_ROLE = keccak256("PAUSER_ROLE");

    // --- core refs ---
    IERC20        public usdc;
    IMZUSD        public mzusd;
    ISwapRouterV3 public router;

    // --- stable whitelist ---
    mapping(address => uint24) public feeForToken; // token => pool fee; 0 means not supported (except USDC in mint flow)

    // --- events ---
    event SwappedToUSDC(address indexed user, address indexed tokenIn, uint256 amountIn, uint256 usdcOut);
    event SwappedAndMinted(address indexed user, address indexed tokenIn, uint256 amountIn, uint256 usdcOut, uint256 mzusdMinted);
    event StableSupportUpdated(address indexed token, uint24 fee, bool supported);

    constructor() { _disableInitializers(); }

    function initialize(address _admin, address _usdc, address _mzusd, address _router) external initializer {
        __AccessControl_init();
        __Pausable_init();
        __ReentrancyGuard_init();
        __UUPSUpgradeable_init();

        usdc   = IERC20(_usdc);
        mzusd  = IMZUSD(_mzusd);
        router = ISwapRouterV3(_router);

        _grantRole(DEFAULT_ADMIN_ROLE, _admin);
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(PAUSER_ROLE, _admin);
    }

    // ---------------------------------------------------------------------
    // Public flows (single-hop)
    // ---------------------------------------------------------------------

    /**
     * @notice Swap a supported stable -> USDC and send USDC to the caller.
     * @param tokenIn    Input ERC20 (must be supported and != USDC for this function).
     * @param amountIn   Exact amount of tokenIn to swap (must be approved to this contract).
     * @param minUsdcOut Minimum USDC expected (slippage guard).
     * @param fee        Uniswap v3 pool fee for tokenIn/USDC (e.g., 100/500/3000/10000). Must match whitelist.
     * @param deadline   Unix timestamp after which the tx reverts if not executed.
     */
    function swapExactInputSingleToUSDC(
        IERC20  tokenIn,
        uint256 amountIn,
        uint256 minUsdcOut,
        uint24  fee,
        uint256 deadline
    ) external whenNotPaused nonReentrant returns (uint256 usdcOut)
    {
        require(amountIn > 0, "amountIn=0");
        require(address(tokenIn) != address(usdc), "use deposit in MZUSD");
        _checkSupported(address(tokenIn), fee);

        tokenIn.safeTransferFrom(msg.sender, address(this), amountIn);
        _approveIfNeeded(tokenIn, address(router), amountIn);

        usdcOut = router.exactInputSingle(
            ISwapRouterV3.ExactInputSingleParams({
                tokenIn: address(tokenIn),
                tokenOut: address(usdc),
                fee: fee,
                recipient: msg.sender,   // USDC directly to user
                deadline: deadline,
                amountIn: amountIn,
                amountOutMinimum: minUsdcOut,
                sqrtPriceLimitX96: 0
            })
        );

        emit SwappedToUSDC(msg.sender, address(tokenIn), amountIn, usdcOut);
    }

    /**
     * @notice Swap a supported stable -> USDC, then call MZUSD.deposit() and send MZUSD to `to`.
     * @dev If tokenIn == USDC, swap is skipped and deposit() is called directly.
     * @param tokenIn    Input ERC20.
     * @param amountIn   Exact amount to swap/deposit.
     * @param minUsdcOut Minimum USDC expected if swapping (ignored if tokenIn == USDC).
     * @param fee        Pool fee for tokenIn/USDC (ignored if tokenIn == USDC).
     * @param deadline   Unix timestamp for swap (ignored if tokenIn == USDC).
     * @param to         Recipient of the resulting MZUSD.
     */
    function swapExactInputSingleToUSDCAndMintMZUSD(
        IERC20  tokenIn,
        uint256 amountIn,
        uint256 minUsdcOut,
        uint24  fee,
        uint256 deadline,
        address to
    ) external whenNotPaused nonReentrant returns (uint256 usdcOut, uint256 mzusdMinted)
    {
        require(amountIn > 0, "amountIn=0");
        require(to != address(0), "to=0");

        if (address(tokenIn) == address(usdc)) {
            // Direct deposit path (no swap)
            usdc.safeTransferFrom(msg.sender, address(this), amountIn);
            _approveIfNeeded(usdc, address(mzusd), amountIn);
            mzusd.deposit(amountIn);               // mints to this contract
            mzusdMinted = amountIn;
            IERC20(address(mzusd)).safeTransfer(to, mzusdMinted);
            emit SwappedAndMinted(msg.sender, address(tokenIn), amountIn, amountIn, mzusdMinted);
            return (amountIn, mzusdMinted);
        }

        _checkSupported(address(tokenIn), fee);

        // Swap stable -> USDC (to this contract)
        tokenIn.safeTransferFrom(msg.sender, address(this), amountIn);
        _approveIfNeeded(tokenIn, address(router), amountIn);

        usdcOut = router.exactInputSingle(
            ISwapRouterV3.ExactInputSingleParams({
                tokenIn: address(tokenIn),
                tokenOut: address(usdc),
                fee: fee,
                recipient: address(this),
                deadline: deadline,
                amountIn: amountIn,
                amountOutMinimum: minUsdcOut,
                sqrtPriceLimitX96: 0
            })
        );

        // Deposit USDC into MZUSD and forward MZUSD to `to`
        _approveIfNeeded(usdc, address(mzusd), usdcOut);
        mzusd.deposit(usdcOut); // mints to this contract
        mzusdMinted = usdcOut;
        IERC20(address(mzusd)).safeTransfer(to, mzusdMinted);

        emit SwappedAndMinted(msg.sender, address(tokenIn), amountIn, usdcOut, mzusdMinted);
    }

    // ---------------------------------------------------------------------
    // Admin
    // ---------------------------------------------------------------------

    /**
     * @notice Add/update/remove supported stable with its Uniswap v3 fee.
     * @param token     Stable token address.
     * @param fee       Pool fee (100/500/3000/10000). Use 0 to remove support.
     * @param supported True to enable, false to disable (equivalent to fee=0).
     */
    function setSupportedStable(address token, uint24 fee, bool supported) external onlyRole(ADMIN_ROLE) {
        if (!supported) {
            feeForToken[token] = 0;
            emit StableSupportUpdated(token, 0, false);
            return;
        }
        require(fee == 100 || fee == 500 || fee == 3000 || fee == 10000, "bad fee");
        feeForToken[token] = fee;
        emit StableSupportUpdated(token, fee, true);
    }

    function pause() external onlyRole(PAUSER_ROLE) { _pause(); }
    function unpause() external onlyRole(PAUSER_ROLE) { _unpause(); }

    /// @notice Rescue any token mistakenly sent here.
    function rescueToken(address token, address to, uint256 amount) external onlyRole(ADMIN_ROLE) {
        require(to != address(0), "to=0");
        IERC20(token).safeTransfer(to, amount);
    }

    // UUPS auth
    /// @notice While restricted is applied to the internal _authorizeUpgrade function, AccessManager should be configured to restrict call to upgradeToAndCall function, as it's the public entry point.
    function _authorizeUpgrade(address newImpl) internal override onlyRole(ADMIN_ROLE) {}

    // ---------------------------------------------------------------------
    // Internal helpers
    // ---------------------------------------------------------------------

    function _approveIfNeeded(IERC20 token, address spender, uint256 amount) internal {
    uint256 cur = token.allowance(address(this), spender);
    if (cur < amount) {
        // add only the missing delta 
        token.safeIncreaseAllowance(spender, amount - cur);
    }
}

    function _checkSupported(address token, uint24 fee) internal view {
        require(feeForToken[token] != 0, "token not supported");
        require(feeForToken[token] == fee, "fee mismatch");
    }

    uint256[48] private __gap;
}
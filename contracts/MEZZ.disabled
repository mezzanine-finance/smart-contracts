// SPDX-License-Identifier: MIT
pragma solidity 0.8.30;

/*
 * MEZZ — MEZZanine token contract
 * - Users deposit USDC → mint MEZZ at oracle price (discount optional) → auto-stake.
 * - Buyback contracts donate MEZZ to staking (no sMEZZ minted).
 */

import "@openzeppelin/contracts-upgradeable/token/ERC20/ERC20Upgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/PausableUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/ReentrancyGuardUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";

interface IOracle {
    function latestPrice() external view returns (uint256); // 1e8 USD per MEZZ

    function latestTimestamp() external view returns (uint256);
}

interface IStakingMEZZ {
    function stakeFromMint(address user, uint256 mezzAmount) external;

    function donateFrom(address from, uint256 mezzAmount) external;
}

contract MEZZ is
    Initializable,
    ERC20Upgradeable,
    AccessControlUpgradeable,
    PausableUpgradeable,
    ReentrancyGuardUpgradeable,
    UUPSUpgradeable
{
    using SafeERC20 for IERC20;

    /* ─────────────── Roles ─────────────── */
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");
    bytes32 public constant PAUSER_ROLE = keccak256("PAUSER_ROLE");
    bytes32 public constant BUYBACK_ROLE = keccak256("BUYBACK_ROLE");

    uint256 public constant BPS_DIVISOR = 10_000;

    /* ─────────────── Core state ─────────────── */
    IERC20 public usdc;
    address public vault;
    IStakingMEZZ public stakingContract;

    /* ─────────────── Pricing ─────────────── */
    IOracle public priceOracle;
    uint256 public maxOracleDelay; // in seconds

    uint256 public discountBps; // 0 = no discount, 10000 = 100% discount, 5000 = 50% discount, 500 = 5% discount
    uint256 public depositLimit; // USDC per tx (0 = unlimited)

    event Minted(
        address indexed user,
        uint256 usdcIn,
        uint256 mezzOut,
        uint256 oraclePrice
    );
    // event BuybackReceived(address indexed from, uint256 mezzAmount);
    
    error ZeroAmount();
    error DepositOverLimit();
    error OracleUnset();
    error PriceZero();
    error OracleStale();
    error DiscountTooBig();
    error BuybackZero();

    constructor() {
        _disableInitializers();
    }

    function initialize(
        address _admin,
        address _usdc,
        address _vault,
        address _staking
    ) external initializer {
        __ERC20_init("MEZZ Token", "MEZZ");
        __AccessControl_init();
        __Pausable_init();
        __ReentrancyGuard_init();
        __UUPSUpgradeable_init();

        usdc = IERC20(_usdc);
        vault = _vault;
        stakingContract = IStakingMEZZ(_staking);

        _grantRole(DEFAULT_ADMIN_ROLE, msg.sender);
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(PAUSER_ROLE, _admin);

        maxOracleDelay = 1 hours;
    }

    /* ────────────────── User mint flow ────────────────── */
    function deposit(uint256 usdcAmount) external whenNotPaused nonReentrant {
        if (usdcAmount == 0) revert ZeroAmount();
        if (depositLimit != 0 && usdcAmount > depositLimit)
            revert DepositOverLimit();
        if (address(priceOracle) == address(0)) revert OracleUnset();

        /* 1) Transfer USDC to vault */
        usdc.safeTransferFrom(msg.sender, vault, usdcAmount);

        /* 2) Oracle price checks */
        uint256 price = priceOracle.latestPrice(); // 1e8 USD / MEZZ
        if (price == 0) revert PriceZero();
        if (block.timestamp - priceOracle.latestTimestamp() > maxOracleDelay)
            revert OracleStale();

        /* 3) Calculate MEZZ amount */
        uint8 usdcDec = IERC20Metadata(address(usdc)).decimals(); // usually 6
        uint256 mezzAmount = (usdcAmount * 1e8 * 10 ** decimals()) /
            price /
            (10 ** usdcDec);

        if (discountBps != 0) {
            mezzAmount =
                (mezzAmount * BPS_DIVISOR) /
                (BPS_DIVISOR - discountBps);
        }

        /* 4) Mint & auto-stake */
        _mint(address(this), mezzAmount);
        _approve(address(this), address(stakingContract), mezzAmount);
        stakingContract.stakeFromMint(msg.sender, mezzAmount);

        emit Minted(msg.sender, usdcAmount, mezzAmount, price);
    }

    // /* ────────────────── Buyback donation ────────────────── */
    // function receiveBuyback(uint256 mezzAmount)
    //     external
    //     onlyRole(BUYBACK_ROLE)
    //     whenNotPaused
    // {
    //     if (mezzAmount == 0) revert BuybackZero();
    //     _approve(address(this), address(stakingContract), mezzAmount);
    //     stakingContract.donateFrom(address(this), mezzAmount);
    //     emit BuybackReceived(msg.sender, mezzAmount);
    // }

    /* ────────────────── Admin setters ────────────────── */
    function setOracle(address _oracle) external onlyRole(ADMIN_ROLE) {
        priceOracle = IOracle(_oracle);
    }

    function setMaxOracleDelay(uint256 _sec) external onlyRole(ADMIN_ROLE) {
        maxOracleDelay = _sec;
    }

    function setDiscount(uint256 _bps) external onlyRole(ADMIN_ROLE) {
        if (_bps >= BPS_DIVISOR) revert DiscountTooBig();
        discountBps = _bps;
    }

    function setDepositLimit(uint256 _lim) external onlyRole(ADMIN_ROLE) {
        depositLimit = _lim;
    }

    // function setBuybackRole(address bb) external onlyRole(ADMIN_ROLE) {
    //     _grantRole(BUYBACK_ROLE, bb);
    // }

    function pause() external onlyRole(PAUSER_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(PAUSER_ROLE) {
        _unpause();
    }

    /* ─────────────── UUPS ─────────────── */
    function _authorizeUpgrade(
        address newImpl
    ) internal override onlyRole(ADMIN_ROLE) {}
}

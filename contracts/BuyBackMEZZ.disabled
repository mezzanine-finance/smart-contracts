// SPDX-License-Identifier: MIT
pragma solidity 0.8.30;
import "@openzeppelin/contracts-upgradeable/utils/ReentrancyGuardUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/PausableUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

/* ---------------------------------------------------------------------
 *  BuybackMEZZ – uses USDC to buy MEZZ on a DEX when price < target
 * -------------------------------------------------------------------*/

contract BuybackMEZZ is Initializable, AccessControlUpgradeable, PausableUpgradeable, ReentrancyGuardUpgradeable, UUPSUpgradeable {
    using SafeERC20 for IERC20;

    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");
    bytes32 public constant BOT_ROLE   = keccak256("BOT_ROLE");

    IMezz public mezzContract;
    IERC20 public usdc;
    IERC20 public mezz;
    IDexRouter public dexRouter;

    address[] public pathUsdcToMezz;   // USDC → ... → MEZZ
    address[] public pathMezzToUsdc;   // MEZZ → ... → USDC (for price check)

    uint256 public priceTarget;        // target MEZZ price in USD * 1e8
    uint256 public maxUsdcPerBuyback;  // cap per tx

    event BuybackExecuted(uint256 usdcSpent, uint256 mezzBought, uint256 priceUsd);

    constructor() { _disableInitializers(); }

    function initialize(address _admin, address _mezzContract, address _dexRouter) external initializer {
        __AccessControl_init();
        __Pausable_init();
        __ReentrancyGuard_init();
        __UUPSUpgradeable_init();

        _grantRole(DEFAULT_ADMIN_ROLE, _admin);
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(BOT_ROLE,   _admin);

        mezzContract = IMezz(_mezzContract);
        mezz = IERC20(_mezzContract);
        usdc = mezzContract.usdc();
        dexRouter = IDexRouter(_dexRouter);
    }

    /* ------------------------------------------------------------------
     *  execute buyback
     * ----------------------------------------------------------------*/
    function executeBuyback(uint256 usdcToSpend) external whenNotPaused nonReentrant onlyRole(BOT_ROLE) {
        require(usdcToSpend > 0 && usdcToSpend <= maxUsdcPerBuyback, "bad amount");
        require(usdc.balanceOf(address(this)) >= usdcToSpend, "no USDC");
        require(priceTarget > 0, "priceTarget 0");

        // --- price check (MEZZ→USDC path) ---
        uint[] memory amountsPx = dexRouter.getAmountsOut(1e18, pathMezzToUsdc); // result in USDC (6 dec)
        uint8 usdcDec = IERC20Metadata(address(usdc)).decimals();
        uint256 currentPrice = amountsPx[amountsPx.length-1] * 1e8 / 10**usdcDec; // USD * 1e8 per 1 MEZZ
        require(currentPrice < priceTarget, "price >= target");

        // --- expected out & minOut (2% slippage) ---
        uint[] memory amountsOut = dexRouter.getAmountsOut(usdcToSpend, pathUsdcToMezz);
        uint256 expectedMezz = amountsOut[amountsOut.length-1];
        uint256 minMezzOut  = expectedMezz * 98 / 100;

        usdc.safeIncreaseAllowance(address(dexRouter), usdcToSpend);
        uint256 mezzBefore = mezz.balanceOf(address(this));
        dexRouter.swapExactTokensForTokens(
            usdcToSpend,
            minMezzOut,
            pathUsdcToMezz,
            address(this),
            block.timestamp
        );
        uint256 mezzBought = mezz.balanceOf(address(this)) - mezzBefore;
        require(mezzBought >= minMezzOut, "swap failed");

        // hand over to MEZZ contract (auto-stake inside)
        mezz.safeTransfer(address(mezzContract), mezzBought);
        mezzContract.receiveBuyback(mezzBought);

        emit BuybackExecuted(usdcToSpend, mezzBought, currentPrice);
    }

    /* ------------------------------------------------------------------
     *  Admin setters
     * ----------------------------------------------------------------*/
    function setPaths(address[] calldata _usdcToMezz, address[] calldata _mezzToUsdc) external onlyRole(ADMIN_ROLE) {
        require(_usdcToMezz[0] == address(usdc) && _usdcToMezz[_usdcToMezz.length-1] == address(mezz), "bad USDC-MEZZ path");
        require(_mezzToUsdc[0] == address(mezz) && _mezzToUsdc[_mezzToUsdc.length-1] == address(usdc), "bad MEZZ-USDC path");
        pathUsdcToMezz = _usdcToMezz;
        pathMezzToUsdc = _mezzToUsdc;
    }
    function setParams(uint256 _priceTarget, uint256 _maxUsdc) external onlyRole(ADMIN_ROLE) {
        priceTarget = _priceTarget;
        maxUsdcPerBuyback = _maxUsdc;
    }
    function grantBot(address bot) external onlyRole(ADMIN_ROLE) { _grantRole(BOT_ROLE, bot); }
    function withdrawToken(address token, uint256 amount) external onlyRole(ADMIN_ROLE) {
        IERC20(token).safeTransfer(msg.sender, amount == 0 ? IERC20(token).balanceOf(address(this)) : amount);
    }
    function pause() external onlyRole(ADMIN_ROLE) { _pause(); }
    function unpause() external onlyRole(ADMIN_ROLE) { _unpause(); }

    /* ---------- UUPS ----------*/
    function _authorizeUpgrade(address newImplementation) internal override onlyRole(ADMIN_ROLE) {}
}


// SPDX-License-Identifier: MIT
pragma solidity 0.8.30;

/**
 * BuybackMEZZ_CoW — custom-error version (UUPS upgradeable)
 *
 * Flow:
 * 1. Bot builds “presign” limit-order (USDC → MEZZ) off-chain.
 * 2. Contract pre-signs UID on-chain → solver executes.
 * 3. MEZZ arrives here; anyone may sweepAndStake() → MEZZ.receiveBuyback().
 */

import "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/PausableUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/utils/ReentrancyGuardUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

interface IMezz {
    function usdc() external view returns (IERC20);

    function receiveBuyback(uint256 mezzAmount) external;
}

interface IGPv2Settlement {
    function setPreSignature(bytes calldata orderUid, bool signed) external;
}

contract BuybackMEZZCoW is
    Initializable,
    AccessControlUpgradeable,
    PausableUpgradeable,
    ReentrancyGuardUpgradeable,
    UUPSUpgradeable
{
    using SafeERC20 for IERC20;

    /* ─────────────── Custom errors ─────────────── */
    error SellOverCap();
    error NoMezzBalance();

    /* ─────────────── Roles ─────────────── */
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");
    bytes32 public constant BOT_ROLE = keccak256("BOT_ROLE");

    /* ─────────────── Core refs ─────────────── */
    IMezz public mezzContract;
    IERC20 public usdc;
    IERC20 public mezz;
    IGPv2Settlement public settlement;

    /* ─────────────── Limits ─────────────── */
    uint256 public maxUsdcPerOrder; // 0 = unlimited

    /* ─────────────── Events ─────────────── */
    event CowOrderPreSigned(
        bytes orderUid,
        uint256 sellUsdc,
        uint256 minBuyMezz,
        uint32 validTo
    );
    event CowOrderRevoked(bytes orderUid);
    event BuybackSwept(uint256 mezzStaked);

    constructor() {
        _disableInitializers();
    }

    function initialize(
        address _admin,
        address _mezzContract,
        address _settlement
    ) external initializer {
        __AccessControl_init();
        __Pausable_init();
        __ReentrancyGuard_init();
        __UUPSUpgradeable_init();

        mezzContract = IMezz(_mezzContract);
        mezz = IERC20(_mezzContract);
        usdc = mezzContract.usdc();
        settlement = IGPv2Settlement(_settlement);

        _grantRole(DEFAULT_ADMIN_ROLE, msg.sender);
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(BOT_ROLE, _admin);

        _ensureMaxAllowance(usdc, address(settlement));
    }

    /* ────────────────── Bot functions ────────────────── */

    function preSign(
        bytes calldata orderUid,
        uint256 sellUsdc,
        uint256 minBuyMezz,
        uint32 validTo
    ) external whenNotPaused onlyRole(BOT_ROLE) {
        if (maxUsdcPerOrder != 0 && sellUsdc > maxUsdcPerOrder)
            revert SellOverCap();

        settlement.setPreSignature(orderUid, true);
        emit CowOrderPreSigned(orderUid, sellUsdc, minBuyMezz, validTo);
    }

    function revokePreSign(
        bytes calldata orderUid
    ) external whenNotPaused onlyRole(BOT_ROLE) {
        settlement.setPreSignature(orderUid, false);
        emit CowOrderRevoked(orderUid);
    }

    /* ────────────────── Sweep purchased MEZZ ────────────────── */

    function sweepAndStake() external whenNotPaused nonReentrant {
        uint256 mezzBalance = mezz.balanceOf(address(this));
        if (mezzBalance == 0) revert NoMezzBalance();

        mezz.safeTransfer(address(mezzContract), bal);
        mezzContract.receiveBuyback(bal); //TODO remove and just send to StakingMEZZ
        emit BuybackSwept(bal);
    }

    /* ────────────────── Admin ────────────────── */

    function setMaxUsdcPerOrder(uint256 cap) external onlyRole(ADMIN_ROLE) {
        maxUsdcPerOrder = cap;
    }

    function setSettlement(
        address newSettlement
    ) external onlyRole(ADMIN_ROLE) {
        settlement = IGPv2Settlement(newSettlement);
        _ensureMaxAllowance(usdc, address(settlement));
    }

    function grantBot(address bot) external onlyRole(ADMIN_ROLE) {
        _grantRole(BOT_ROLE, bot);
    }

    function pause() external onlyRole(ADMIN_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(ADMIN_ROLE) {
        _unpause();
    }

    /* ────────────────── UUPS ────────────────── */
    function _authorizeUpgrade(
        address newImpl
    ) internal override onlyRole(ADMIN_ROLE) {}

    /* ────────────────── Internal helper ────────────────── */
    // ────────────────── Internal helper ──────────────────
    function _ensureMaxAllowance(IERC20 token, address spender) internal {
        // if allowance⊂max → выставляем MAX_UINT256 безопасно
        if (token.allowance(address(this), spender) < type(uint256).max) {
            token.forceApprove(spender, type(uint256).max);
        }
    }

    uint256[48] private __gap;
}

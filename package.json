{
    "name": "mezzanine",
    "version": "1.0.0",
    "description": "mezzanine protocol",
    "private": true,
    "scripts": {
        "gen:docs": "rm -rf docs && npx hardhat docgen",
        "gen:abi": "rm -rf abi && npx hardhat export-abi",
        "coverage": "npx hardhat coverage",
        "slither": "npm run slither:foundry",
        "slither:foundry": "npm run clean:build && slither . --config-file ./slither.config.json --foundry-out-directory out-foundry",
        "aderyn": "bash scripts/commands/aderyn.sh",
        "slither:md": "npm run clean:build && bash scripts/commands/slither.sh",
        "slither:md:strict": "npm run clean:build && cross-env SLITHER_STRICT=true bash scripts/commands/slither.sh",
        "size": "npm run compile:force && npx hardhat size-contracts",
        "format": "npx prettier --write .",
        "lint": "npm run lint:ts && npm run lint:sol",
        "lint:fix": "npm run lint:ts:fix && npm run lint:sol:fix",
        "lint:staged": "lint-staged",
        "lint:ts": "npx prettier --check \"**/*.{ts,js}\" && npx eslint .",
        "lint:ts:fix": "npx prettier --write \"**/*.{ts,js}\" && npx eslint . --fix",
        "lint:sol": "npx hardhat check && npx prettier --check \"contracts/**/*.sol\"",
        "lint:sol:fix": "npx solhint --fix \"contracts/**/*.sol\" && npx prettier --write \"contracts/**/*.sol\"",
        "compile": "npx hardhat compile",
        "compile:force": "npm run compile -- --force",
        "test": "npx hardhat test",
        "test:fork": "cross-env FORKING=true npm test",
        "test:gas": "cross-env REPORT_GAS=true SERIAL=true RUN_OPTIMIZER=true npm test",
        "test:trace": "npm test -- --trace",
        "test:trace:full": "npm test -- --fulltrace",
        "test:check": "npm test -- --typecheck",
        "test:gas:json": "cross-env REPORT_GAS_TO_FILE=json npm run test:gas",
        "test:gas:md": "cross-env REPORT_GAS_TO_FILE=md npm run test:gas",
        "forge:build": "forge build",
        "forge:test": "forge test -vv",
        "forge:test:fuzz": "forge test --match-path 'test/foundry/fuzz/*.t.sol' -vv",
        "forge:test:fuzz:ci": "FOUNDRY_PROFILE=ci forge test --match-path 'test/foundry/fuzz/*.t.sol' -vv",
        "forge:coverage:fuzz": "forge coverage --match-path 'test/foundry/fuzz/*.t.sol' --report summary --ir-minimum",
        "forge:test:ci": "FOUNDRY_PROFILE=ci forge test -vv",
        "clean": "bash scripts/commands/clean.sh",
        "clean:build": "bash scripts/commands/clean.sh build",
        "clean:oz": "bash scripts/commands/clean.sh oz",
        "clean:ignition": "bash scripts/commands/clean.sh ignition",
        "clean:cov": "bash scripts/commands/clean.sh coverage",
        "prepare": "husky install",
        "coverage:4g": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run coverage",
        "coverage:8g": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npm run coverage",
        "deploy": "npx hardhat run scripts/deployment/deploy.ts",
        "deploy:hardhat": "npm run deploy -- --network hardhat",
        "deploy:fresh": "cross-env DEPLOY_FRESH=true npm run deploy",
        "deploy:hardhat:fresh": "cross-env DEPLOY_FRESH=true npm run deploy -- --network hardhat",
        "deploy:sepolia": "npm run deploy -- --network sepolia",
        "deploy:sepolia:fresh": "cross-env DEPLOY_FRESH=true npm run deploy -- --network sepolia",
        "deploy:mainnet": "npm run deploy -- --network mainnet",
        "deploy:mainnet:fresh": "cross-env DEPLOY_FRESH=true npm run deploy -- --network mainnet",
        "deploy:upgrade:tranches": "npx hardhat run scripts/deployment/upgradeTranches.ts",
        "deploy:upgrade:tranches:sepolia": "npm run deploy:upgrade:tranches -- --network sepolia",
        "deploy:upgrade:tranches:sepolia:validate": "cross-env UPGRADE_VALIDATE_ONLY=true npm run deploy:upgrade:tranches:sepolia",
        "deploy:mock-nav-submitter": "npx hardhat run scripts/deployment/deployMockNavSubmitterAutomation.ts",
        "deploy:cre-receivers": "npx hardhat run scripts/deployment/deployCREAutomationReceivers.ts",
        "deploy:cre-receivers:sepolia": "npm run deploy:cre-receivers -- --network sepolia",
        "deploy:cre-receivers:sepolia:plan": "CRE_RECEIVERS_PLAN=true npm run deploy:cre-receivers:sepolia",
        "deploy:cre-receivers:sepolia:validate": "CRE_RECEIVERS_VALIDATE=true npm run deploy:cre-receivers:sepolia",
        "deploy:grant-roles": "npx hardhat run scripts/deployment/grantRoles.ts",
        "deploy:renounce-roles": "npx hardhat run scripts/deployment/renounceRoles.ts",
        "deploy:handoff-roles": "npx hardhat run scripts/deployment/handoffRoles.ts"
    },
    "lint-staged": {
        "**/*.sol": [
            "prettier --write",
            "solhint --fix"
        ],
        "**/*.{js,ts}": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "engines": {
        "node": ">=22.21.1",
        "npm": ">=11.6.2"
    },
    "devDependencies": {
        "@commitlint/cli": "19.6.1",
        "@commitlint/config-conventional": "19.6.0",
        "@eslint/compat": "1.2.4",
        "@eslint/js": "9.39.0",
        "@nomicfoundation/hardhat-toolbox": "6.1.1",
        "@nomiclabs/hardhat-solhint": "4.0.1",
        "@openzeppelin/contracts": "5.4.0",
        "@openzeppelin/contracts-upgradeable": "5.4.0",
        "@openzeppelin/hardhat-upgrades": "3.9.1",
        "@prb/math": "4.1.0",
        "@types/eslint__js": "8.42.3",
        "cross-env": "^10.1.0",
        "dotenv": "16.4.7",
        "eslint": "9.39.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "15.14.0",
        "hardhat": "^2.28.0",
        "hardhat-abi-exporter": "2.11.0",
        "hardhat-contract-sizer": "2.10.1",
        "hardhat-tracer": "3.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.11",
        "mocha": "11.7.4",
        "chalk": "^5.4.1",
        "prettier": "^3.4.2",
        "prettier-plugin-solidity": "^2.1.0",
        "solidity-coverage": "0.8.16",
        "solidity-docgen": "0.6.0-beta.36",
        "typescript-eslint": "8.46.2"
    },
    "overrides": {
        "hardhat-gas-reporter": "2.2.2"
    },
    "dependencies": {
        "@chainlink/contracts": "^1.5.0"
    },
    "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
